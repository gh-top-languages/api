{
  "name": "@gh-top-languages/api",
  "private": true,
  "description": "Deployable GitHub language chart generator — embeddable SVGs for READMEs and websites",
  "keywords": [
    "typescript",
    "github-profile",
    "github-readme",
    "top-languages",
    "svg"
  ],
  "homepage": "https://github.com/gh-top-languages/api#readme",
  "bugs": {
    "url": "https://github.com/gh-top-languages/api/issues"
  },
  "license": "MIT",
  "author": "Mason L'Etoile",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gh-top-languages/api.git"
  },
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node --env-file-if-exists=.env dist/server.js"
  },
  "dependencies": {
    "@gh-top-languages/lib": "^1.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.0.17",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  }
}
